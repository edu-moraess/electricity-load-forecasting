# Copy this file to .env and adjust values as needed.
# No API key is required for ONS or Open-Meteo -- both are open public APIs.
# These overrides exist for testing against alternate endpoints or tuning
# HTTP/backtesting behavior; the defaults in src/utils/config.py work as-is.

# ONS_SUBSYSTEM=SE
# REQUEST_TIMEOUT_SECONDS=30
# REQUEST_MAX_RETRIES=3
# CACHE_TTL_MINUTES=30
# BACKTEST_MIN_TRAIN_DAYS=60
# BACKTEST_TEST_WINDOW_DAYS=7
# BACKTEST_N_FOLDS=5
# RANDOM_SEED=42
